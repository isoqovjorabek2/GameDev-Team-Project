{
  "name": "unity-game-backend",
  "version": "1.0.0",
  "description": "Backend server for Unity games with MongoDB and real-time multiplayer support",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "start:prod": "NODE_ENV=production node src/server.js",
    "dev": "nodemon src/server.js",
    "dev:debug": "nodemon --inspect src/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\"",
    "db:setup": "node scripts/setupDatabase.js",
    "db:seed": "node scripts/seedDatabase.js",
    "db:reset": "node scripts/resetDatabase.js",
    "db:backup": "node scripts/backupDatabase.js",
    "clean": "rm -rf node_modules package-lock.json",
    "build": "echo 'No build step required for Node.js'",
    "verify": "npm run lint && npm run test",
    "prepare": "husky install || true"
  },
  "keywords": [
    "unity",
    "game",
    "backend",
    "mongodb",
    "websocket",
    "multiplayer",
    "real-time"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "supertest": "^6.3.4"
  }
}
